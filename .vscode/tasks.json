{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (dev)",
            "detail": "Gera o .exe de desenvolvimento",
            "icon": { "id": "package", "color": "terminal.ansiCyan" },
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": []
        }
    ]
}
